#!/usr/bin/env bash

echo "=========================================="
echo "  INITIALIZING FETTENO-OS ENVIRONMENT"
echo "=========================================="

# 0. Enable Developer Groups (Docker, Virtualization, etc.)
echo "-> Enabling Developer Mode permissions..."
# Verrà richiesta la password per i permessi di amministratore
sudo ujust dx-group

# 1. Install Microsoft Core Fonts safely via Homebrew
echo "-> Installing Microsoft Fonts..."
brew tap colindean/fonts-nonfree
brew install font-microsoft-core-fonts

# 2. Install Dev tools and isolated Python via Homebrew
echo "-> Installing Python, Helm, and Minikube..."
brew install minikube helm python

# 3. Install SDKMAN, Java 21 LTS, and Maven
echo "-> Installing SDKMAN, Java 21, and Maven..."
curl -s "https://get.sdkman.io?rcupdate=false" | bash

# Load SDKMAN into the current shell session
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# Install the specific Java version and Maven
sdk install java 21.0.2-tem
sdk install maven

echo "------------------------------------------"
echo " Setup completed successfully!"
echo " Please close and reopen this terminal, or run: source ~/.zshrc"
echo "=========================================="
