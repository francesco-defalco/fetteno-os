#!/usr/bin/env bash

echo "=========================================="
echo "  INITIALIZING FETTENO-OS DEV ENVIRONMENT"
echo "=========================================="

# 1. Enable Developer Groups (Docker, Virtualization, etc.)
# Questo comando di Aurora-DX ti aggiunge ai gruppi necessari per usare container e VM senza sudo.
echo "-> Enabling Developer Mode permissions (ti verrà chiesta la password)..."
sudo ujust dx-group

# 2. Install Dev tools (Kubernetes & Python) via Homebrew
echo "-> Installing Python, Helm, and Minikube..."
brew install minikube helm python

# 3. Install SDKMAN, Java 21 LTS, and Maven
echo "-> Installing SDKMAN, Java 21 LTS, and Maven..."
export SDKMAN_DIR="$HOME/.sdkman"
curl -s "https://get.sdkman.io?rcupdate=false" | bash

# Carica SDKMAN nella sessione corrente per poter lanciare subito i comandi 'sdk'
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

echo "-> Downloading Java and Maven..."
sdk install java 21.0.2-tem
sdk install maven

# 4. Apply automated fixes for Zsh environment
echo "-> Applying Zsh terminal configurations..."

# Aggiunge Homebrew al PATH (se per caso il profilo globale non l'ha già caricato)
if ! grep -q "brew shellenv" ~/.zshrc; then
    echo -e '\n# Homebrew' >> ~/.zshrc
    echo 'eval "$(/var/home/linuxbrew/.linuxbrew/bin/brew shellenv)"' >> ~/.zshrc
fi

# Aggiunge l'inizializzazione di SDKMAN al file Zsh
if ! grep -q "SDKMAN_DIR" ~/.zshrc; then
    echo -e '\n# SDKMAN' >> ~/.zshrc
    echo 'export SDKMAN_DIR="$HOME/.sdkman"' >> ~/.zshrc
    echo '[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"' >> ~/.zshrc
fi

# Fix per il fastidioso warning di dipendenza "batcat" che a volte dà SDKMAN
if ! grep -q 'alias batcat="cat"' ~/.zshrc; then
    echo -e '\n# SDKMAN fix' >> ~/.zshrc
    echo 'alias batcat="cat"' >> ~/.zshrc
fi

echo "------------------------------------------"
echo " Setup completed successfully!"
echo " Riavvia il terminale (o fai logout/login) per applicare le modifiche."
echo "=========================================="
