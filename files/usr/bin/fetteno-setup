#!/usr/bin/env bash

echo "=========================================="
echo "  INITIALIZING FETTENO-OS DEV ENVIRONMENT"
echo "=========================================="

# 1. Enable Developer Groups (Docker, Virtualization, etc.)
echo "-> Enabling Developer Mode permissions (sudo required)..."
sudo ujust dx-group

# 2. Install Dev tools (Kubernetes, Python, Go) via Homebrew
echo "-> Installing Python, Go, Helm, and Minikube..."
brew install minikube helm python go

# 3. Install Rust via rustup (Official standard)
echo "-> Installing Rust toolchain..."
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
source "$HOME/.cargo/env"

# 4. Install SDKMAN, Java 21 LTS, and Maven
echo "-> Installing SDKMAN, Java 21 LTS, and Maven..."
export SDKMAN_DIR="$HOME/.sdkman"
curl -s "https://get.sdkman.io?rcupdate=false" | bash
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

echo "-> Downloading Java and Maven..."
sdk install java 21.0.2-tem
sdk install maven

# 5. Apply automated fixes for Zsh environment
echo "-> Applying Zsh terminal configurations..."

# Configure Zsh History
if ! grep -q "HISTFILE" ~/.zshrc; then
    echo -e '\n# Zsh History Configuration' >> ~/.zshrc
    echo 'export HISTFILE="$HOME/.zsh_history"' >> ~/.zshrc
    echo 'export HISTSIZE=10000' >> ~/.zshrc
    echo 'export SAVEHIST=10000' >> ~/.zshrc
    echo 'setopt APPEND_HISTORY' >> ~/.zshrc
    echo 'setopt SHARE_HISTORY' >> ~/.zshrc
    echo 'setopt HIST_IGNORE_DUPS' >> ~/.zshrc
    echo 'setopt HIST_IGNORE_SPACE' >> ~/.zshrc
fi

# Add Homebrew to PATH
if ! grep -q "brew shellenv" ~/.zshrc; then
    echo -e '\n# Homebrew' >> ~/.zshrc
    echo 'eval "$(/var/home/linuxbrew/.linuxbrew/bin/brew shellenv)"' >> ~/.zshrc
fi

# Add Rust to PATH
if ! grep -q ".cargo/env" ~/.zshrc; then
    echo -e '\n# Rust' >> ~/.zshrc
    echo 'source "$HOME/.cargo/env"' >> ~/.zshrc
fi

# Add SDKMAN init
if ! grep -q "SDKMAN_DIR" ~/.zshrc; then
    echo -e '\n# SDKMAN' >> ~/.zshrc
    echo 'export SDKMAN_DIR="$HOME/.sdkman"' >> ~/.zshrc
    echo '[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"' >> ~/.zshrc
fi

# Add Local Bin to PATH (Useful for custom user scripts)
if ! grep -q "$HOME/.local/bin" ~/.zshrc; then
    echo -e '\n# Local Binaries' >> ~/.zshrc
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
fi

# SDKMAN batcat dependency warning fix
if ! grep -q 'alias batcat="cat"' ~/.zshrc; then
    echo -e '\n# SDKMAN fix' >> ~/.zshrc
    echo 'alias batcat="cat"' >> ~/.zshrc
fi

# 6. Install Google Antigravity (CLI + IDE)
echo "-> Installing Google Antigravity CLI..."
curl -fsSL https://antigravity.google/cli/install.sh | bash
echo "-> CLI installed successfully!"

echo "-> Downloading Antigravity IDE from official servers..."
# Impostiamo l'URL generico per l'ultima versione Linux di Antigravity
IDE_URL="https://antigravity.google/download/linux-x64/latest.tar.gz"
TEMP_TARBALL="/tmp/antigravity-ide.tar.gz"

# Usa curl per scaricare il file. L'opzione -f fa fallire elegantemente il comando se l'URL non è raggiungibile.
if curl -fL "$IDE_URL" -o "$TEMP_TARBALL"; then
    echo "-> Download completed. Extracting files..."
    
    mkdir -p "$HOME/.local/opt/antigravity"
    tar -xzf "$TEMP_TARBALL" -C "$HOME/.local/opt/antigravity" --strip-components=1
    rm "$TEMP_TARBALL"
    
    echo "-> Creating application menu shortcut..."
    mkdir -p "$HOME/.local/share/applications"
    
    cat << EOF > "$HOME/.local/share/applications/antigravity.desktop"
[Desktop Entry]
Name=Google Antigravity
Comment=Google AI Agent Platform
Exec=$HOME/.local/opt/antigravity/antigravity --no-sandbox %F
Icon=applications-development
Type=Application
Categories=Development;IDE;
Terminal=false
EOF

    update-desktop-database "$HOME/.local/share/applications" 2>/dev/null
    echo "-> Antigravity IDE installed and integrated into the system!"

else
    echo "-> WARNING: Could not download the IDE directly from the web."
    echo "-> Looking for a manual download in the Downloads folder..."
    
    # Fallback: se il download fallisce, cerca l'archivio precedentemente scaricato a mano
    IDE_TARBALL=$(ls $HOME/Downloads/antigravity*.tar.gz $HOME/Scaricati/antigravity*.tar.gz 2>/dev/null | head -n 1)

    if [ -n "$IDE_TARBALL" ]; then
        echo "-> Found local IDE archive: $IDE_TARBALL"
        mkdir -p "$HOME/.local/opt/antigravity"
        tar -xzf "$IDE_TARBALL" -C "$HOME/.local/opt/antigravity" --strip-components=1
        
        mkdir -p "$HOME/.local/share/applications"
        cat << EOF > "$HOME/.local/share/applications/antigravity.desktop"
[Desktop Entry]
Name=Google Antigravity
Comment=Google AI Agent Platform
Exec=$HOME/.local/opt/antigravity/antigravity --no-sandbox %F
Icon=applications-development
Type=Application
Categories=Development;IDE;
Terminal=false
EOF
        update-desktop-database "$HOME/.local/share/applications" 2>/dev/null
        echo "-> Antigravity IDE installed using local archive!"
    else
        echo "-> ERROR: IDE archive not found locally either."
        echo "-> To install the IDE manually, download the .tar.gz file from the Google website,"
        echo "-> save it in your Downloads folder, and run this script again."
    fi
fi

echo "------------------------------------------"
echo " Setup completed successfully!"
echo " Python, Go, Rust, Java, and Antigravity are ready."
echo " Please log out and log back in to apply all changes."
echo "=========================================="
