#!/usr/bin/env bash

echo "=========================================="
echo "  INITIALIZING FETTENO-OS ENVIRONMENT"
echo "=========================================="

# 0. Enable Developer Groups (Docker, Virtualization, etc.)
echo "-> Enabling Developer Mode permissions..."
sudo ujust dx-group

# 1. Install Microsoft Core Fonts safely via Homebrew
echo "-> Installing Microsoft Fonts..."
brew tap colindean/fonts-nonfree
brew install font-microsoft-core-fonts

# 2. Install Dev tools and isolated Python via Homebrew
echo "-> Installing Python, Helm, and Minikube..."
brew install minikube helm python

# 3. Install SDKMAN, Java 21 LTS, and Maven
echo "-> Installing SDKMAN, Java 21, and Maven..."
curl -s "https://get.sdkman.io?rcupdate=false" | bash

# Load SDKMAN into the current shell session for immediate use
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

sdk install java 21.0.2-tem
sdk install maven

# 4. Apply automated fixes for Zsh environment
echo "-> Applying Zsh terminal configurations..."

# Add Homebrew to PATH if not already present
if ! grep -q "brew shellenv" ~/.zshrc; then
    echo 'eval "$(/var/home/linuxbrew/.linuxbrew/bin/brew shellenv)"' >> ~/.zshrc
fi

# Add SDKMAN initialization if not already present
if ! grep -q "SDKMAN_DIR" ~/.zshrc; then
    echo 'export SDKMAN_DIR="$HOME/.sdkman"' >> ~/.zshrc
    echo '[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"' >> ~/.zshrc
fi

# Fix SDKMAN batcat dependency warning
if ! grep -q 'alias batcat="cat"' ~/.zshrc; then
    echo 'alias batcat="cat"' >> ~/.zshrc
fi

echo "------------------------------------------"
echo " Setup completed successfully!"
echo " Please log out and log back in to apply all changes."
echo "=========================================="
